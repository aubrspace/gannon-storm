Name Root Last Stride nThread
#COMPONENTMAP
GM  0 -3 -1  -1         GM runs on 0:nProc-3 multithreaded
IE -2 -1  1             IE runs on last 2 PE-s
IM -2 -2  1             IM runs on nProc-2 PE

#INCLUDE
RESTART.in

#DESCRIPTION
First run with MED density and MED velocity

#TIMEACCURATE
T			DoTimeAccurate

#PROGRESS
100			DnProgressShort
1000			DnProgressLong

#SAVERESTART
T			DoSaveRestart
-1			DnSaveRestart
120 min			DtSaveRestart

CPUTIMEMAX
3.75 hour		CpuTimeMax [sec]

#RESTARTOUTDIR
SWMF_RESTART.YYYYMMDD_HHMMSS		NameRestartOutDir

#CHECKKILL
GM			NameCompCheckKill

#CHECKSTOP
T			DoCheckStop
-1			DnCheckStop
60 min		DtCheckStop

#COUPLEORDER
5			nCouple
IE GM			NameSourceTarget
IE IM			NameSourceTarget
GM IE			NameSourceTarget
GM IM			NameSourceTarget
IM GM			NameSourceTarget

#COUPLE2
GM			NameComp1
IE			NameComp2
-1			DnCouple
5.0			DtCouple

#COUPLE2
IM			NameComp1
GM			NameComp2
-1			DnCouple
10.0			DtCouple

#COUPLE1
IE			NameSource
IM			NameTarget
-1			DnCouple
10.0			DtCouple

#COUPLETIME
GM			NameComp
F			DoCoupleOnTime

#UPDATEB0
0.5			DtUpdateB0


#BEGIN_COMP GM ---------------------------------------------------------------

#INCLUDE
GM/restartIN/restart.H

#GRIDBLOCKALL
12000                    MaxBlock

#GRID
1			nRootBlock_D(x_)
1			nRootBlock_D(y_)
1			nRootBlock_D(z_)
-224.			xMin
 32.			xMax
-128.			yMin
 128.			yMax
-128.			zMin
 128.			zMax

! Maximum resolution initially
#GRIDRESOLUTION
2.0			Resolution
initial			NameArea

! Minimum resolution in the computational domain
#GRIDRESOLUTION
8.0			Resolution
all			NameArea

#GRIDRESOLUTION
1.0                     Resolution
box                     NameArea
-100.0                  xMinBox
 -16.0                  yMinBox
 -16.0                  zMinBox
  22.0                  xMaxBox
  16.0                  yMaxBox
  16.0                  zMaxBox

! Better res at geosync and near tail.
#GRIDRESOLUTION
1/4
box
-20.0                  xMinBox
-8.0                   yMinBox
-8.0                   zMinBox
 8.0                   xMaxBox
 8.0                   yMaxBox
 8.0                   zMaxBox


! Close tail and bow shock resolution
#GRIDRESOLUTION
1/2			Resolution
box
-32.0
-25.0
-25.0
 20.0
 25.0
 25.0			zMaxBox

! Approximate mp boundary with paraboloid
#GRIDRESOLUTION
1/2			    Resolution
paraboloidx
 20.0            xPosition
 0.0             yPosition
 0.0             zPosition
-52.0            Height
 35.0            Radius

#GRIDRESOLUTION
1/8			    Resolution
shell0			NameArea
2.5			    r1Shell
8.0			    r2Shell

! reset the step counter to avoid accumulation to large numbers
#NSTEP
10			nStep

#OUTERBOUNDARY
outflow			TypeBc1
vary			TypeBc2
float			TypeBc3
float			TypeBc4
float			TypeBc5
float			TypeBc6

#INNERBOUNDARY
ionosphere		TypeBcBody

! Set the inner boundary density as Rho0Cpcp + RhoPerCpcp*CPCP[keV]
#CPCPBOUNDARY
T			UseCpcpBc  (rest is read if true)
28.0			Rho0Cpcp   [amu/cc]
0.1			RhoPerCpcp [amu/cc / keV]

#INNERBCPE
0.1

#SOLARWINDFILE
T			            UseSolarWindFile
MEDnLOWu_IMF.dat	    NameSolarWindFile

! Satellite trajectories
INCLUDE
SATELLITES.in

#MAGPERTURBINTEGRAL
T                       UseSurfaceIntegral
T                       UseFastFacIntegral
MAG			            TypeCoordIndex
MAG                     TypeCoordFacGrid

#MAGNETOMETER
Param/supermag.dat		NameMagInputFile
single			TypeFileOut
-1			DnOutput
1 min			DtOutput

#GEOMAGINDICES
180			nSizeKpWindow [min]
1 min			DtOutput      [sec]

#MAGNETOMETERGRID
1			nMagGridFiles
global ascii		StrGridFileOut
GEO			    TypeCoordMagGrid
360			    nLonMagGrid
180			    nLatMagGrid
0.			    LonMinMagGrid
360.			LonMaxMagGrid
-80.			LatMinMagGrid
80.			    LatMaxMagGrid
-1			    DnSaveMagGrid
1 min			DtSaveMagGrid

#SUPERMAGINDICES
T			DoWriteSupermagIndices

#CONSERVATIVECRITERIA
1			nConservCrit
parabola		TypeConservCrit
 5.0			xParabolaConserv
15.0			yParabolaConserv

#TRACE
T           UseTrace
T           UseAccurateTrace
0.1         DtExchangeTrace [sec]
1           DnTrace

#TRACEIE
T           DoTraceIE


! Setting 1
#IMCOUPLING
20.0			TauCoupleIm
T			DoImSatTrace
T			DoCoupleImPressure
T			DoCoupleImDensity
0.01			DensityCoupleFloor
F			DoFixPolarRegion

End of setting 1

! Setting 2
IMCOUPLING
20.0			TauCoupleIm
T			DoImSatTrace
T			DoCoupleImPressure
T			DoCoupleImDensity
0.01			DensityCoupleFloor
T			DoFixPolarRegion
5.0			rFixPolarRegion
56.0			PolarNDim [amu/cc]
50000.0			PolarTDim [K]

IMCOUPLINGSMOOTH
10.0			dLatSmoothIm [deg]

End of setting 2

! Pressures below pMinDim are replaced with pMinDim.
#MINIMUMPRESSURE
1e-5			pMinDim [nPa]

#SAVELOGNAME
F			UseLogNameStep
T			UseLogNameDateTime

#SAVEPLOTNAME
F			UsePlotNameStep
F			UsePlotNameTime
T			UsePlotNameDateTime

#PLOTFILENAME
date			NameMaxTimeUnit

#SAVELOGFILE
T			DoSaveLogfile
VAR step date		StringLog
-1			DnSaveLogfile
5.0			DtSaveLogfile
dt rho mx my mz p bx by bz pmin pmax dst_sm dstflx cpcpn cpcps
3.0			StringLogRadii

#SCHEME
2			nOrder
Sokolov			TypeFlux
mc3			TypeLimiter
1.2			LimiterBeta

#BORIS
T			UseBorisCorrection
0.02			BorisClightFactor

#REGION
borisregion		NameRegion
sphere tapered	StringShape
-4.0			xPosition
0.0			    yPosition
0.0			    zPosition
14.0			Radius
2.0			    Taper

#BORISREGION
borisregion		NameBorisRegion

#TIMESTEPPING
2			    nStage
0.85			CflExpl

#SAVEPLOT
1                                               nPlotFiles
3d VAR tcp		                                stringplot
-1			                                    dnsaveplot
1 min 			                                dtsaveplot
{MHD} status theta1 theta2 phi1 phi2 dvol       namevars
{default}                                       namepars

#END_COMP GM -----------------------------------------------------------------

#BEGIN_COMP IM ---------------------------------------------------------------

#RESTART
T			DoRestart

! Number density fractions for H+ and O+. Has to add up to 1.0
#COMPOSITION
FIXED			NameCompModel
0.8			FractionH
0.2			FractionO

! Decay for RCM particle densities
#DECAY
T 			UseDecay
10 hour			DecayTimescale

#END_COMP IM -----------------------------------------------------------------

#BEGIN_COMP IE ---------------------------------------------------------------

#RESTART
T			DoRestart

#IONOSPHERE
5			TypeConductanceModel
F			UseFullCurrent
F			UseFakeRegion2
-1.0			F107Flux
1.0			StarLightPedConductance
0.25			PolarCapPedConductance

#BOUNDARY
10.0			LatBoundary

#CONDUCTANCEFILES
cmee_hal_coeffs.dat	NameHalFile
cmee_ped_coeffs.dat	NamePedFile

#AURORALOVAL
T			UseOval (rest of parameters read if true)
T			UseOvalShift
F			UseSubOvalConductance
T			UseAdvancedOval
F			DoFitCircle (read if UseAdvancedOval is true)

#USECMEE
T			UseCMEEFitting
45			LatNoConductanceSI
7.5			FactorHallCMEE
5			FactorPedCMEE

#SAVEPLOT
1			            nPlotFile
max tec                 StringPlot
-1                      DnSavePlot
60 			            DtSavePlot

#END_COMP IE -----------------------------------------------------------------

