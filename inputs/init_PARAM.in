Name Root Last Stride nThread
#COMPONENTMAP
GM  0 -3 -1  -1         GM runs on 0:nProc-3 multithreaded
IE -2 -1  1             IE runs on last 2 PE-s
IM -2 -2  1             IM runs on nProc-2 PE
RB -1 -1  1		! RB runs on nProc-1 PE

#DESCRIPTION
Gannon storm with RB initial PARAM

#TIMEACCURATE
F			DoTimeAccurate

#STARTTIME            
2024			year
5			month
10			day
13			hour
0 			minute
0			second
0			fracsecond

#COMPONENT
IM			NameComp
F			UseComp

#COMPONENT
RB			NameComp
F			UseComp

#COUPLE2
GM			NameComp1
IE			NameComp2
10                      DnCouple
-1                      DtCouple

#BEGIN_COMP GM ---------------------------------------------------------------

#GRIDBLOCKALL
39000                    MaxBlock

#GRID
1			nRootBlock_D(x_)
1			nRootBlock_D(y_)
1			nRootBlock_D(z_)
-224.			xMin
 32.			xMax
-128.			yMin
 128.			yMax
-128.			zMin
 128.			zMax

! Maximum resolution initially
#GRIDRESOLUTION
2.0			Resolution
initial			NameArea

! Minimum resolution in the computational domain
#GRIDRESOLUTION
8.0			Resolution
all			NameArea

#GRIDRESOLUTION
1.0                     Resolution
box                     NameArea
-100.0                  xMinBox
 -16.0                  yMinBox
 -16.0                  zMinBox
  22.0                  xMaxBox
  16.0                  yMaxBox
  16.0                  zMaxBox

! Better res at geosync and near tail.
#GRIDRESOLUTION
1/4
box
-20.0                  xMinBox
-8.0                   yMinBox
-8.0                   zMinBox
 8.0                   xMaxBox
 8.0                   yMaxBox
 8.0                   zMaxBox


! Close tail and bow shock resolution
#GRIDRESOLUTION
1/2			Resolution
box
-32.0
-25.0
-25.0
 20.0
 25.0
 25.0			zMaxBox

! Approximate mp boundary with paraboloid
#GRIDRESOLUTION
1/2			    Resolution
paraboloidx
 20.0            xPosition
 0.0             yPosition
 0.0             zPosition
-52.0            Height
 35.0            Radius

#GRIDRESOLUTION
1/16			Resolution
shell0			NameArea
2.0			r1Shell
3.0			r2Shell

#GRIDRESOLUTION
1/8			Resolution
shell0			NameArea
3.0			r1Shell
8.0			r2Shell

#BODY
T                       UseBody
2.0                     rBody     (in planet radius)
2.375                   rCurrents (in planet radius)
28.0                    BodyNDim  (/cc)
25000.0                 BodyTDim  (K)

#TIMESTEPPING
1			    nStage
0.80			CflExlp

#OUTERBOUNDARY
outflow			TypeBc1
vary			TypeBc2
float			TypeBc3
float			TypeBc4
float			TypeBc5
float			TypeBc6

#INNERBOUNDARY
ionosphere		TypeBcInner

! This is now the default, but may not be optimal
MAGNETICINNERBOUNDARY
-1			    B1rCoef

! Set the inner boundary density as Rho0Cpcp + RhoPerCpcp*CPCP[keV]
#CPCPBOUNDARY
T                       UseCpcpBc  (rest is read if true)
28.0                    Rho0Cpcp   [amu/cc]
0.1                     RhoPerCpcp [amu/cc / keV]

#INNERBCPE
0.1

#SOLARWINDFILE
